# Copiar a .env.local el día de conexión. No commitear secretos.

# memory = fakes locales (default, sirve para Vercel sin Supabase)
# real = createRealApp() con Supabase, Edge Config, Cloudflare y Vercel
APP_RUNTIME=memory

# Supabase (obligatorio solo si APP_RUNTIME=real)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Omite RLS. Nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Connection string de lectura de Edge Config.
EDGE_CONFIG=
# ID del store para mutaciones PATCH /v1/edge-config/:id/items
EDGE_CONFIG_ID=

# Cloudflare
# El zone_id no es global: tenant_domains.cloudflare_zone_id
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Turnstile (cuando existan formularios públicos)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Solo desarrollo local. Nunca en producción.
TENANT_DEV_ID=11111111-1111-4111-8111-111111111111
TENANT_DEV_HOSTNAME=localhost
