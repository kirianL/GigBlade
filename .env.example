# Copiar a .env.local el día de conexión. No commitear secretos.

# memory = fakes locales (default, sirve para Vercel sin Supabase)
# real = createRealApp() con Supabase, Edge Config, Cloudflare y Vercel
APP_RUNTIME=memory

# Supabase (obligatorio solo si APP_RUNTIME=real)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Omite RLS. Nunca NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel REST (no uses el prefijo VERCEL_: está reservado en el dashboard)
PLATFORM_VERCEL_TOKEN=
# Solo local. En Vercel ya existen VERCEL_PROJECT_ID y VERCEL_ORG_ID.
PLATFORM_VERCEL_PROJECT_ID=
PLATFORM_VERCEL_TEAM_ID=
# Connection string de lectura de Edge Config.
EDGE_CONFIG=
# ID del store para mutaciones PATCH /v1/edge-config/:id/items
EDGE_CONFIG_ID=

# Cloudflare
# El zone_id no es global: tenant_domains.cloudflare_zone_id
# Token de la API de Cloudflare para el registro de dominios.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Turnstile (cuando existan formularios públicos)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Correo de acceso al panel. Opcional: sin estas dos, la contraseña se muestra una sola vez en el panel.
RESEND_API_KEY=
PANEL_MAIL_FROM=

# Contraseña del usuario platform (hola@gigblade.com) en el panel.
GIGBLADE_PANEL_PASSWORD=

# Panel (Vite). Landing → redirige login aquí. Producción: https://app.gigblades.com
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
# URL pública de la landing (producción: https://gigblades.com)
# NEXT_PUBLIC_SITE_URL=https://gigblades.com

# Opcional: dominio compartido para la cookie de sesión entre landing y panel
# PANEL_SESSION_COOKIE_DOMAIN=.gigblades.com

# Solo desarrollo local. Nunca en producción.
# localhost:3000 = landing GigBlade.
# marco.localhost:3000 = modo claro (pista)
# luna.localhost:3000 = modo oscuro (festival)
# nox.localhost:3000 o demo.localhost:3000 = party (after)
TENANT_DEV_ID=11111111-1111-4111-8111-111111111111
TENANT_DEV_HOSTNAME=nox.localhost
